{
  "name": "rcloneweb",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Beautiful rclone backup panel — Node.js + React rewrite",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test test/ && vitest run",
    "test:server": "node --test test/",
    "test:web": "vitest run",
    "reset-password": "node server/cli.js reset-password",
    "cron": "node server/cli.js cron",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@codemirror/legacy-modes": "^6.5.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@uiw/react-codemirror": "^4.24.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
