{
  "name": "rcloneweb",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "description": "Beautiful rclone backup panel — Node.js + React rewrite",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test \"test/**/*.test.mjs\" && vitest run",
    "test:server": "node --test \"test/**/*.test.mjs\"",
    "test:web": "vitest run",
    "reset-password": "node server/cli.js reset-password",
    "cron": "node server/cli.js cron",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "lucide-react": "^1.40.0",
    "motion": "^13.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@codemirror/legacy-modes": "^6.5.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@uiw/react-codemirror": "^4.24.0",
    "@vitejs/plugin-react": "^4.5.0",
    "happy-dom": "^20.13.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
